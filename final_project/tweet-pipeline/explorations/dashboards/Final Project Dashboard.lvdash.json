    {
      "name": "1ae94c7e",
      "displayName": "tweets_bronze",
      "config": {
        "version": "1.1",
        "source": "workspace.default.tweets_bronze",
        "dimensions": [
          {
            "name": "date",
            "expr": "source.date",
            "displayName": "Date"
          },
          {
            "name": "user",
            "expr": "source.user",
            "displayName": "User"
          },
          {
            "name": "text",
            "expr": "source.text",
            "displayName": "Text"
          },
          {
            "name": "sentiment",
            "expr": "source.sentiment",
            "displayName": "Sentiment"
          },
          {
            "name": "source_file",
            "expr": "source.source_file",
            "displayName": "Source File"
          },
          {
            "name": "processing_time",
            "expr": "source.processing_time",
            "displayName": "Processing Time"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Total Tweets Count"
          }
        ]
      }
    },
    {
      "name": "dcbb923f",
      "displayName": "Top Ten Users by Number of Tweets Generated",
      "queryLines": [
        "SELECT User, COUNT(*) AS tweets_count\r\n",
        "FROM tweets_bronze\r\n",
        "GROUP BY User\r\n",
        "ORDER BY tweets_count DESC\r\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "17e6afb5",
      "displayName": "Sentiment Analysis Mentions Overview Dataset",
      "queryLines": [
        "SELECT mention, (positive-negative) AS positive_sentiment_power\r\n",
        "FROM gold_tweet_aggregations\r\n",
        "ORDER BY positive_sentiment_power DESC\r\n",
        "LIMIT 20\r\n"
      ]
    },
    {
      "name": "a0b4f399",
      "displayName": "Top Mentions Ranked by Sentiment Imbalance Score",
      "queryLines": [
        "SELECT mention, (negative-positive) AS negative_sentiment_power\r\n",
        "FROM gold_tweet_aggregations\r\n",
        "ORDER BY negative_sentiment_power DESC\r\n",
        "LIMIT 20"
      ]
    }
  ],
