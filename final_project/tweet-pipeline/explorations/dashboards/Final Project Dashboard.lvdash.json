{
  "datasets": [
    {
      "name": "a0b16dba",
      "displayName": "tweets_silver",
      "config": {
        "version": "1.1",
        "source": "workspace.default.tweets_silver",
        "dimensions": [
          {
            "name": "timestamp",
            "expr": "source.timestamp",
            "displayName": "Timestamp"
          },
          {
            "name": "mention",
            "expr": "source.mention",
            "displayName": "Mention"
          },
          {
            "name": "cleaned_text",
            "expr": "source.cleaned_text",
            "displayName": "Cleaned Text"
          },
          {
            "name": "text",
            "expr": "source.text",
            "displayName": "Text"
          },
          {
            "name": "sentiment",
            "expr": "source.sentiment",
            "displayName": "Sentiment"
          }
        ],
        "measures": [
          {
            "name": "Tweets With Mention",
            "expr": "COUNT(*) FILTER (WHERE mention IS NOT NULL)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Mention Count"
          },
          {
            "name": "count non mention",
            "expr": "COUNT(*) FILTER (WHERE mention is NULL)",
            "displayName": "Tweets Without Mentions"
          }
        ]
      }
    },
